{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the OpenTake main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
