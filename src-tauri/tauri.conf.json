{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTake",
  "version": "1.0.0-beta.3",
  "identifier": "com.opentake.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "cwd": "..",
      "script": "pnpm -C web dev"
    },
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "pnpm -C web build"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenTake",
        "width": 1600,
        "height": 1000,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        },
        "dragDropEnabled": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "font-src": "'self' data:",
        "frame-ancestors": "'none'",
        "img-src": "'self' opentake-asset: http://opentake-asset.localhost blob: data: http://127.0.0.1:*",
        "media-src": "'self' opentake-asset: http://opentake-asset.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* ws://localhost:*",
        "font-src": "'self' data:",
        "frame-ancestors": "'none'",
        "img-src": "'self' opentake-asset: http://opentake-asset.localhost blob: data: http://127.0.0.1:*",
        "media-src": "'self' opentake-asset: http://opentake-asset.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPCACHE/**/*",
            "$APPDATA/OpenTake/Library/**/*",
            "$RESOURCE/**/*"
          ],
          "deny": [
            "$HOME/.ssh/**/*",
            "$HOME/.gnupg/**/*",
            "$HOME/.aws/**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../LICENSE",
      "../NOTICE",
      "resources/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "version": "1.0.0.3"
      }
    }
  }
}
